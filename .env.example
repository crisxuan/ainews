# Standalone server
NODE_ENV=production
HOST=0.0.0.0
PORT=3000

# Neon PostgreSQL（不配置时网站会回退到仓库内的 JSON 快照）
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Vercel Cron + AI Gateway（Vercel 部署会自动提供 VERCEL_OIDC_TOKEN）
CRON_SECRET=replace-with-a-random-secret-at-least-16-characters
# 本地调试时可选；线上无需长期密钥
AI_GATEWAY_API_KEY=
OPENAI_RADAR_MODEL=openai/gpt-5-mini
OPENAI_BRIEFING_MODEL=openai/gpt-5-mini
